# Copy to .env and fill in values. Restart dev server after changes: npm run dev
# Never commit .env to git.

# —— Site & contact (public URLs) ——
VITE_SITE_URL=https://cheffarahammar.com
VITE_WHATSAPP_URL=https://wa.me/972XXXXXXXXX
VITE_INSTAGRAM_URL=https://instagram.com/your_handle

# —— Firebase (storefront + admin) ——
# See firebase/README.md for project setup, rules, and product seed.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# —— Optional REST API (used when Firebase vars are empty) ——
# VITE_API_BASE=https://example.com/api
